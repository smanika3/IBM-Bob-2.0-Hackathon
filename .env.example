# .env.example
# ChangeProof — no external API keys or secrets are required.
# This file is safe to commit. Never commit a real .env file.

# API server port (default: 3001)
PORT=3001

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Database file path (default: changeproof.db in project root)
# DATABASE_PATH=./changeproof.db
