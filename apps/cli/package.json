{
  "name": "@changeproof/cli",
  "version": "0.1.0",
  "description": "CLI for ChangeProof",
  "type": "module",
  "bin": {
    "changeproof": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@changeproof/analysis": "workspace:*",
    "@changeproof/domain": "workspace:*",
    "@changeproof/ingestion": "workspace:*",
    "@changeproof/reporting": "workspace:*",
    "@changeproof/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
