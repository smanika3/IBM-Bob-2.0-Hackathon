{
  "name": "changeproof",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first change-readiness workbench",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive --filter './packages/*' build && pnpm --recursive --filter './apps/*' build",
    "test": "pnpm --recursive test",
    "test:watch": "pnpm --recursive test:watch",
    "test:e2e": "pnpm --filter './apps/web' test:e2e",
    "lint": "pnpm --recursive lint",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml}\" --ignore-path .prettierignore",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml}\" --ignore-path .prettierignore",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
